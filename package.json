{
  "name": "agent-hive",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Hive, an AIoT agent management system",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "queen": "tsx packages/queen/src/index.ts",
    "worker": "tsx packages/worker/src/index.ts",
    "console": "npm run dev --workspace @hive/web",
    "broker": "tsx packages/shared/src/bus/broker-entry.ts",
    "solo": "node --env-file-if-exists=.env scripts/solo.mjs",
    "stop": "node --env-file-if-exists=.env scripts/stop.mjs",
    "bench": "tsx bench/src/run.ts",
    "scoreboard": "tsx demo/scoreboard.ts",
    "breed": "tsx packages/queen/src/breed/cli.ts",
    "watch": "tsx demo/watch.ts",
    "reset": "node --env-file-if-exists=.env scripts/reset.mjs",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json",
    "docs:install": "npm --prefix docs install",
    "docs:dev": "npm --prefix docs run docs:dev",
    "docs:build": "npm --prefix docs run docs:build",
    "docs:preview": "npm --prefix docs run docs:preview"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^10.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
