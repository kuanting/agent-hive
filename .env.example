# Agent Hive — example environment configuration
#
# Copy to `.env` and adjust. Every value below is the built-in default, so an
# empty .env still gives you a working local setup.
#
#   cp .env.example .env
#
# The queen, workers, and the web dev server load `.env` via dotenv at startup.
# Run npm scripts from the repo root — the services read `.env` from the
# current working directory. Real environment variables take precedence over
# anything set here.

# ---------------------------------------------------------------------------
# Message bus (backend selection)
# ---------------------------------------------------------------------------

# Which broker the queen and workers use:
#   amqp -> RabbitMQ. THE DEFAULT and the production path.
#   mqtt -> embedded Aedes broker. Lightweight mode: one machine, no Docker.
# `npm run solo` sets this to mqtt automatically; anything else gets RabbitMQ.
#
# Lightweight mode must be asked for by name. This used to fall back to "mqtt if
# MQTT_URL is set", so merely leaving MQTT_URL in a .env — `demo/watch.ts` reads
# it too — silently moved a Queen onto the backend with weaker delivery
# guarantees. The two genuinely differ: RabbitMQ acks after the work finishes and
# redelivers a crashed worker's task to a peer, while the embedded broker acks on
# receipt and relies on the Queen's reaper. Which one is running should be a
# decision, never an inference.
HIVE_BROKER=amqp

# --- amqp backend (RabbitMQ) ---
# AMQP connection string used by the queen and every worker.
# `docker compose up -d rabbitmq` starts a broker matching this default
# (management UI on http://localhost:15672, guest/guest).
# Remote broker with credentials: amqp://user:password@host:5672
# TLS: amqps://user:password@host:5671
AMQP_URL=amqp://localhost:5672

# --- mqtt backend (embedded Aedes, lightweight mode) ---
# Connection string used when HIVE_BROKER=mqtt. Setting this alone does NOT
# select the backend — see the note above.
MQTT_URL=mqtt://localhost:1883
# Port the embedded broker listens on (`npm run broker`, and the solo launcher).
MQTT_BROKER_PORT=1883

# --- delivery, lightweight mode only ---
# The embedded broker is at-most-once: it acks a task on receipt, so nothing
# redelivers a dispatch that was lost or a task whose bee died. The Queen watches
# for both using the progress ticks a bee sends for every task it holds, and
# redispatches — bounded by the same 3-attempt limit as a failure. On RabbitMQ
# these do nothing, deliberately: there an undelivered message is still sitting in
# its queue, so redispatching would enqueue a second copy.

# No progress tick at all within this window means the dispatch never landed.
# Comfortably above HIVE_PROGRESS_MS, since a bee ticks once immediately.
HIVE_ACCEPT_TIMEOUT_MS=15000

# A bee that WAS ticking and then went quiet this long is presumed dead.
HIVE_STALL_TIMEOUT_MS=30000

# --- stopping the hive on purpose ---
# `POST /shutdown` (loopback only, body {"confirm":"shutdown"}) tells every bee
# to drain and exit, then stops the Queen last. Nothing else does this: a Queen
# that crashes, restarts or is redeployed deliberately leaves its bees running,
# since they are autonomous consumers and usually on other machines.

# How long a draining bee waits for its in-flight work before leaving anyway.
# A bee mid-call has already spent those tokens, so finishing is free and
# abandoning is not; the cap only stops one wedged call from hanging a shutdown.
HIVE_DRAIN_GRACE_MS=60000

# How long the Queen waits for the fleet to say goodbye. Above the bee's own cap,
# so in the normal case everyone reports in and the Queen never has to guess.
HIVE_SHUTDOWN_WAIT_MS=75000

# ---------------------------------------------------------------------------
# Queen (orchestrator)
# ---------------------------------------------------------------------------

# HTTP port the queen listens on.
QUEEN_PORT=4100

# Root directory for the queen's persisted state / ledger.
HIVE_ROOT=.

# On-disk artifact store. Relative paths resolve against the process cwd.
HIVE_ARTIFACTS=artifacts

# ---------------------------------------------------------------------------
# Watching the hive work
# ---------------------------------------------------------------------------
# Jobs take time, and a hive is several processes. These three decide how much
# of that is visible in the console's Activity view (and in each bee's terminal).
#
# One rule holds regardless of what you set here: a log line carries identifiers
# and decisions, never prompt or output text. Confidentiality is a promise about
# where work runs, and narration must not be the side door out of it.

# Threshold for both a bee's terminal output and what it publishes for the
# console. `info` is today's output unchanged. `debug` adds per-task detail;
# `warn` leaves only the things worth interrupting someone for — deferrals,
# budget refusals, agent fallbacks, permanent failures.
HIVE_LOG_LEVEL=info

# How often a bee publishes "still working" while a task runs, in milliseconds.
# This is the ONLY signal between dispatch and result: adapters are a single
# buffered call, so there is no partial output to stream and no percentage to
# report. What it buys is the difference between a slow task and a dead bee.
# Set to 0 to turn the ticks off entirely.
HIVE_PROGRESS_MS=5000

# How many recent lines the Queen keeps for a console that was just opened.
# Bounded on purpose: this is the one structure that grows with elapsed time
# rather than with work done.
HIVE_LOG_BUFFER=500

# How many tasks one bee runs at once. Explicit because it used to be a side
# effect: the embedded broker withheld its ack until the handler finished, which
# serialized delivery and quietly meant "one at a time". That ack now fires on
# receipt, so the limit has to be stated. Tasks over the cap queue in the bee and
# keep ticking, so the Queen can tell "held" from "lost".
HIVE_MAX_CONCURRENT_TASKS=1

# How long an unanswered lease top-up request suppresses the next one. Previously
# a permanent latch cleared only by the grant, so one lost grant disabled
# per-token work for the life of the process.
HIVE_LEASE_RETRY_MS=30000

# ---------------------------------------------------------------------------
# Planner (local LLM)
# ---------------------------------------------------------------------------

# Ollama model the planner uses to decompose goals into tasks. This one is
# checked at Queen startup and NEVER substituted: if it is not installed the
# Queen warns loudly and every chat turn arrives unplanned, because routing,
# decomposition and the confidentiality tag all come out of this call.
HIVE_PLANNER_MODEL=gemma4:12b

# Abort a planning call after this many milliseconds.
HIVE_PLANNER_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Planner experience: plan guide + learned memory
# ---------------------------------------------------------------------------
# Both feed the planner prompt only. Neither can reach tier or budget: those
# stay with QueenCore. Set either to 0 for a byte-reproducible demo.

# Hand-authored guides in customers/plan-guide.md and customers/<id>.plan-guide.md.
HIVE_PLAN_GUIDE=1
HIVE_GUIDE_BUDGET_CHARS=1200

# Memory the Queen writes itself, under data/memory/<customerId>/.
HIVE_MEMORY=1
HIVE_MEMORY_BUDGET_CHARS=800
HIVE_MEMORY_MAX_RECALL=3
HIVE_MEMORY_MAX_FILES=32

# ---------------------------------------------------------------------------
# Agent runtimes
# ---------------------------------------------------------------------------

# Ollama server, shared by the planner, worker capability discovery, and the
# ollama-agent adapter. Powers the 🏠 local bee (tier 3).
OLLAMA_URL=http://localhost:11434

# --- 💵 metered bee (tier 2, per-token API) ---
#
# The ONLY credentials the hive reads. Set a key and the metered bee advertises
# that provider's models; leave it unset and the worker's preflight silently
# drops those capabilities, so the hive runs fine without any of them.
#
# The 🍯 honey bee needs NO key here — Claude Code and Codex authenticate through
# their own CLI sessions (`claude` / `codex` login), which is exactly what makes
# them prepaid rather than per-token.
#
# Model ids must match llm_model_api_catalog.yaml so calls are priced correctly.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# GOOGLE_API_KEY is accepted as an alias for GEMINI_API_KEY.

# Skip the network on api-runtime calls but still report realistic token counts,
# so the ledger, the worker budget guard and the USD cap behave exactly as live.
# Useful for re-running or recording a demo without spending. Unset = live calls.
# HIVE_API_DRYRUN=1

# Output-token ceiling for a single api-runtime call. Kept equal to the worker's
# projection assumption by default, so the pre-flight cost estimate and the real
# bill agree instead of drifting apart.
# HIVE_API_MAX_OUTPUT_TOKENS=2000

# ---------------------------------------------------------------------------
# 🏡 Personal bee (tier 3): the user's agent over local personal data.
# Also serves the ollama-agent adapter's openclaw/hermes runtimes.
# ---------------------------------------------------------------------------

# OpenClaw gateway (OpenAI-compatible). Preferred backend when it is listening.
# Probed with GET /v1/models, and only a JSON answer counts: OpenClaw's control
# UI shares this port and returns HTML for any path, which is not a chat surface.
OPENCLAW_URL=http://localhost:18789

# Binary invoked for Hermes-backed runs (must be on PATH, or give a full path).
# This is what `agent: hermes` in a bee's yaml probes for. Naming an agent there
# is a preference, not a pin: if this binary is missing the bee still answers on
# the next backend, and the substitution is reported in the result's `runtime`.
# Run as `hermes chat -q <prompt> -m <model> -Q`. Hermes always advertises tools,
# so the model must support tool calling — gemma4, qwen3.5 and gpt-oss all do,
# but not every local model does (Ollama replies 400 "does not support tools"
# and the bee degrades to the next backend). PERSONAL_MODEL pins which it gets.
HERMES_CMD=hermes

# Inference provider passed to Hermes. Defaults to `ollama`, since Hermes here
# serves locally-installed models. Set `auto` to use Hermes' own default, or
# leave empty to pass no --provider at all.
# HERMES_PROVIDER=ollama

# Directory the personal bee may read (email, files, calendar, notes). Sandboxed:
# nothing outside this root is reachable. Relative to the repo root by default.
PERSONAL_DATA_DIR=demo/personal-data

# Overrides the `model:` a personal bee configures, for whichever backend serves
# it. Unset = the bee's own model, else the first installed local Ollama model.
# PERSONAL_MODEL=gemma4:12b

# Let the mini agent drive sandboxed tools itself instead of deterministic
# prefetch. Off by default; small local models are unreliable at tool calls.
# PERSONAL_TOOL_LOOP=1

# Timeout for a single agent execution, shared by both adapters (300 seconds).
# A ceiling, not a target: fast runtimes return immediately, so raising it only
# affects how long a stuck agent hangs before it is killed.
HIVE_EXEC_TIMEOUT_MS=300000

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------

# Path to the worker's YAML config. A CLI argument takes precedence:
#   npm run worker -- <worker-config.yaml>
# WORKER_CONFIG=./worker-config.yaml

# ---------------------------------------------------------------------------
# Web console (build/dev time only — read by vite.config.ts)
# ---------------------------------------------------------------------------

# Queen origin the dev server proxies API requests to.
QUEEN_URL=http://localhost:4100
