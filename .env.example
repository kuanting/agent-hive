# Agent Hive — example environment configuration
#
# Copy to `.env` and adjust. Every value below is the built-in default, so an
# empty .env still gives you a working local setup.
#
#   cp .env.example .env
#
# The queen, workers, and the web dev server load `.env` via dotenv at startup.
# Run npm scripts from the repo root — the services read `.env` from the
# current working directory. Real environment variables take precedence over
# anything set here.

# ---------------------------------------------------------------------------
# Message bus (RabbitMQ)
# ---------------------------------------------------------------------------

# AMQP connection string used by the queen and every worker.
# `docker compose up -d rabbitmq` starts a broker matching this default
# (management UI on http://localhost:15672, guest/guest).
# Remote broker with credentials: amqp://user:password@host:5672
# TLS: amqps://user:password@host:5671
AMQP_URL=amqp://localhost:5672

# ---------------------------------------------------------------------------
# Queen (orchestrator)
# ---------------------------------------------------------------------------

# HTTP port the queen listens on.
QUEEN_PORT=4100

# Root directory for the queen's persisted state / ledger.
HIVE_ROOT=.

# On-disk artifact store. Relative paths resolve against the process cwd.
HIVE_ARTIFACTS=artifacts

# ---------------------------------------------------------------------------
# Planner (local LLM)
# ---------------------------------------------------------------------------

# Ollama model the planner uses to decompose goals into tasks.
HIVE_PLANNER_MODEL=gemma3:4b

# Abort a planning call after this many milliseconds.
HIVE_PLANNER_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Agent runtimes
# ---------------------------------------------------------------------------

# Ollama server, shared by the planner, worker capability discovery, and the
# ollama-agent adapter.
OLLAMA_URL=http://localhost:11434

# OpenClaw gateway used by the ollama-agent adapter.
OPENCLAW_URL=http://localhost:18789

# Binary invoked for Hermes-backed runs (must be on PATH, or give a full path).
HERMES_CMD=hermes

# Timeout for a single agent execution, shared by both adapters (300 seconds).
# A ceiling, not a target: fast runtimes return immediately, so raising it only
# affects how long a stuck agent hangs before it is killed.
HIVE_EXEC_TIMEOUT_MS=300000

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------

# Path to the worker's YAML config. A CLI argument takes precedence:
#   npm run worker -- <worker-config.yaml>
# WORKER_CONFIG=./worker-config.yaml

# ---------------------------------------------------------------------------
# Web console (build/dev time only — read by vite.config.ts)
# ---------------------------------------------------------------------------

# Queen origin the dev server proxies API requests to.
QUEEN_URL=http://localhost:4100
